<aura:component controller="editactions" implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction" access="global" >
	<aura:attribute name="data" type="Object"/>
    <aura:attribute name="columns" type="List"/>
    <aura:attribute name="draftValues" type="Object" default="[]"/>
    <aura:handler event="force:refreshView" action="{!c.doInit}" />
    <aura:handler name="init" value="{! this }" action="{! c.doInit }"/>

    <div class="slds-p-around_medium">
        <h2 class="slds-text-heading_large">Team Actions</h2>
    </div>

   <div >
       
        <lightning:datatable class="hello"
                             style="slds-table slds-table_cell-buffer slds-table_resizable-cols slds-table_striped slds-table_bordered slds-table_col-bordered"
                             aura:id="dtTable"
                             columns="{! v.columns }"
                             data="{! v.data }"
                             keyField="Id"
                             wrap-text-max-lines="10"
                             hideCheckboxColumn="true"
                             draftValues="{! v.draftValues }"
                             onsave="{! c.handleSave }"
                             />

    </div>
   
</aura:component>