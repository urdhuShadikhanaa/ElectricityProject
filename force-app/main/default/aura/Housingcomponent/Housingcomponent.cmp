<aura:component implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,lightning:availableForFlowScreens,force:lightningQuickAction" controller="displaycontracthousing" access="global" >
     <!-- CREATE ATTRIBUTE/VARIABLE-->
    <aura:attribute name="searchResult" type="List" description="use for store and display account list return from server"/>
    <aura:attribute name="searchKeyword" type="String" description="use for store user search input"/>
    <aura:attribute name="Message" type="boolean" default="false" description="use for display no record found message"/>
    <aura:attribute name="TotalNumberOfRecord" type="integer" default="0" description="use for display Number of records"/>
    
    <!-- SHOW LOADING SPINNER--> 
    <lightning:spinner variant="brand" size="large" aura:id="Id_spinner" class="slds-hide" />
    
    <div class="slds-m-around_medium">
       <!-- SEARCH INPUT AND SEARCH BUTTON--> 
        <lightning:layout>
            <lightning:layoutItem size="3" padding="around-small">
                <lightning:input value="{!v.searchKeyword}"
                                 required="true"
                                 placeholder="search housing on contract by model.."
                                 aura:id="searchField"
                                 label="Housing Models"/>
            </lightning:layoutItem>
            <lightning:layoutItem size="2" padding="around-small">
                <lightning:button onclick="{!c.Search}"
                                  variant="brand"
                                  label="Search"
                                  iconName="utility:search"/> 
            </lightning:layoutItem>
        </lightning:layout>
       
        <!-- TOTAL RECORDS BADGES--> 
        <div class="slds-m-around_x-small">
            <lightning:badge label="{!v.TotalNumberOfRecord}" />
        </div>
        
        <!-- ERROR MESSAGE IF NOT RECORDS FOUND--> 
        <aura:if isTrue="{!v.Message}">
            <div class="slds-notify_container slds-is-relative">
                <div class="slds-notify slds-notify_toast slds-theme_error" role="alert">
                    <div class="slds-notify__content">
                        <h2 class="slds-text-heading_small">No Records Found...</h2>
                    </div>
                </div>
            </div>
        </aura:if>
       
        <!-- TABLE CONTENT--> 
        <table class="slds-table slds-table_bordered slds-table_cell-buffer">
            <thead>
                <tr class="slds-text-title_caps">
                    <th scope="col">
                        <div class="slds-truncate" title="S.no">No:</div>
                    </th>
                    <th scope="col">
                        <div class="slds-truncate" title="Account Name">Model</div>
                    </th>
                    <th scope="col">
                        <div class="slds-truncate" title="Type">Pressure Tier</div>
                    </th>
              <th scope="col">
                        <div class="slds-truncate" title="Type">Type</div>
                    </th> 
                    <th scope="col">
                        <div class="slds-truncate" title="Type">For Meter Installation Size:</div>
                    </th> 
                           <th scope="col">
                        <div class="slds-truncate" title="Type">Mounting</div>
                    </th> 
                    <th scope="col">
                        <div class="slds-truncate" title="Type">Supplier</div>
                    </th> 
                    <th scope="col">
                        <div class="slds-truncate" title="Type">Supplier Price</div>
                    </th> 
                </tr>
            </thead>
            <tbody> 
                <!--### display all records of searchResult attribute by aura:iteration ###-->
                <aura:iteration items="{!v.searchResult}" var="Con" indexVar="count">
                    <tr>
                        <td>
                            <div class="slds-truncate">{!count + 1}</div>
                        </td>
                        <td>
                            <div class="slds-truncate">{!Con.np_Model__c}</div>
                        </td>
                        <td>
                            <div class="slds-truncate">{!Con.Pressure_Tier__c}</div>
                        </td>
             <td>
                            <div class="slds-truncate">{!Con.Housing_Type__c}</div>
                        </td>
                        <td>
                            <div class="slds-truncate">{!Con.For_Meter_Installation_Size__c}</div>
                        </td>  
                        <td>
                            <div class="slds-truncate">{!Con.Mounting__c}</div>
                        </td>
                         <td>
                            <div class="slds-truncate">{!Con.Supplier__r.Name}</div>
                        </td>
                        <td>
                            <div class="slds-truncate">£{!Con.Supplier_Price__c}</div>
                        </td> 
                    </tr>
                </aura:iteration>
            </tbody>
        </table>
    </div>
</aura:component>