<aura:component implements="force:hasRecordId,force:lightningQuickActionWithoutHeader,lightning:actionOverride,lightning:availableForFlowActions,lightning:hasPageReference" access="global" >
	 <aura:handler  name="init" value="{!this}" action="{!c.init}" input="{!this.slds-form-element}"/>
    <aura:html tag="style">
           .slds-modal__container{ 
    max-height: auto;
    
        width: 100%; max-width: 70vh; 
   display:flex !important;
   } 
  .modal-body{ 
     display:flex !important; 
        max-height: auto;
  
   } 
   
   
</aura:html>
    <section role="dialog" tabindex="-1" aria-label="Create New Case Modal Style" aria-modal="true" aria-describedby="modal-content-id-1" class="slds-modal slds-fade-in-open">

  <div class="slds-modal__container">
   
<div class="slds-modal__content slds-p-around_medium" id="modal-content-id-1">
    <lightning:flow aura:id="flowData1a"/></div>
        </div>     
       
      </section>

    
         
</aura:component>